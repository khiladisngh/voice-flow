{
  "printWidth": 100,
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "singleQuote": false
      }
    },
    {
      "files": ["*.md"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["*.code-workspace"],
      "options": {
        "parser": "json",
        "trailingComma": "none"
      }
    }
  ]
}
